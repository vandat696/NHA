# Database — the team default is the SHARED Neon Cloud Postgres.
# Paste the connection string from the Neon project into DATABASE_URL and
# keep it out of Git (.env is gitignored). Never commit the real value.
# Full workflow: docs/04-devops/local-environment.md § Workflow A.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/DATABASE?sslmode=require"

# Alternative — local PostgreSQL from docker-compose (Workflow B, opt-in,
# a database of your own that nobody else sees). Use this line instead of
# the one above, then run `pnpm bootstrap` from the repo root.
# DATABASE_URL="postgresql://nha:nha_password@localhost:5432/nha?schema=public"

# Browsers that may call this API. Empty in development means the Expo web
# dev server (http://localhost:8081, :19006); empty in production means no
# browser at all, which is correct for a native-only client.
CORS_ORIGINS=""

# Auth (JWT). Generate a long random JWT_ACCESS_SECRET per environment —
# never commit a real one.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Social login (WBS 1.1.8–1.1.9). Leave empty to disable a provider — its
# endpoints then return 503. Redirect URI to register with the provider:
#   <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/<google|facebook>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE_URL="http://localhost:3000"
# Where the callback may hand the token pair back to, as a redirect with the
# tokens in the URL fragment. Comma-separated, matched exactly — never echo a
# caller's own value, or this route becomes a way to post real credentials to
# any address. Leave empty and the callback answers JSON as before, which is
# what Swagger and a browser test see.
#   dev:  http://localhost:8081/auth/callback,nha://auth/callback
OAUTH_APP_REDIRECTS=""

# Media uploads (WBS 1.5.3) — root folder of the local-disk storage backend
# used for the MVP demo. Relative paths resolve against apps/api.
UPLOAD_DIR="./uploads"

# Cloudflare R2 media storage (opt-in). Set STORAGE_DRIVER to "r2" only after
# filling these values from Cloudflare R2 API Tokens. Never commit real keys.
# When unset, the API uses the local-disk backend above.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nha-media-dev"
STORAGE_DRIVER="local"

# AI service integration (sprint 2, docs/03-ai/architecture.md). The AI
# team's FastAPI presents AI_SERVICE_TOKEN in X-AI-Service-Token on the
# /internal/ai/* routes; NestJS calls the service at AI_SERVICE_URL.
# Leave both empty in local dev — AI surfaces then answer 503 cleanly and
# the core product keeps working (product-overview.md § 14).
AI_SERVICE_TOKEN=""
AI_SERVICE_URL=""

# Outgoing email (WBS 1.1.7 password reset). MVP transport is Gmail SMTP
# with an app password (decided 2026-08-18): host smtp.gmail.com, port 587,
# SMTP_USER = the Gmail address, SMTP_PASS = an app password (NOT the
# account password — create one at myaccount.google.com/apppasswords).
# Leave empty in local dev: reset codes are then logged to the API console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# AI service (apps/ai — FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_TOKEN=

# Yahoo Shopping (san JP) cho man 22 Where to buy — thieu thi UI roi ve link tim kiem
YAHOO_SHOPPING_APPID=

# --- Cong suat: chi dat khi may khac han may dev (do 21/08 tren 16 luong) ---
#
# So video duoc dung CUNG LUC. Moi luot render tu chay 5 ffmpeg, nen 2 luot la
# ~10 process; cao hon thi API cham cho ca nguoi chi dang xem anh. Job thu ba
# doi trong hang, app hien "dang cho toi luot".
VIDEO_MAX_CONCURRENT_RENDERS=2
#
# So ffmpeg trong MOT luot render. Mac dinh = so nhan / 3, toi da 5.
# Tren Render (container) os.cpus() la so nhan may VAT LY -> dat = 1, xem
# docs/04-devops/deploy.md.
# VIDEO_RENDER_CONCURRENCY=5
#
# So luong x264 cho moi process ffmpeg (segment + ghep cuoi). Mac dinh 4: du
# nhanh, va giu RAM buoc ghep ~1GB thay vi phinh theo so nhan may vat ly.
# May dev nhieu nhan muon render nhanh hon thi tang.
# VIDEO_FFMPEG_THREADS=4
#
# Chung cat lai ho so sau moi N bai dang. 1 = goi y hieu bai vua dang ngay
# (dung khi demo); 3 = giam ~40% token cua luong dang bai, doi lai goi y cham
# hieu bai moi nhat mot hai bai.
ROLLUP_EVERY_N_POSTS=1
#
# UV_THREADPOOL_SIZE (sharp + doc file) KHONG dat duoc o day: Nest doc .env sau
# khi tien trinh da chay, qua muon. Code tu dat = so nhan (toi da 16) trong
# src/threadpool.ts; muon doi thi dat bien moi truong that truoc khi chay node.
