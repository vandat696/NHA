# Git and prettier agree on LF everywhere (root .prettierrc: endOfLine "lf").
# Prevents phantom "modified" files on Windows checkouts (core.autocrlf).
* text=auto eol=lf

# Windows batch scripts require CRLF to run
*.bat text eol=crlf
*.cmd text eol=crlf

# Font đóng gói cho video (apps/api/assets/fonts) — nhị phân, không đổi EOL
*.otf binary
*.ttf binary
